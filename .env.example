# Copy to .env at the REPO ROOT (this directory), not backend/.
#
# NOTE: never put an inline "# comment" after a value in this file.
# dotenv reads `KEY=               # note` as the literal value "# note",
# which silently produces a non-empty setting that looks configured but is not.
# Comments go on their own line.

# --- LLM provider: ollama | anthropic ---
LLM_PROVIDER=anthropic

# Needed when LLM_PROVIDER=anthropic. Starts with sk-ant-
ANTHROPIC_API_KEY=

# Needed when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Speech to text ---
DEEPGRAM_API_KEY=

# --- Database ---
DATABASE_URL=postgresql://sc_user:sc_password@localhost:5432/sales_copilot

# --- Queue / cache (not used yet) ---
REDIS_URL=redis://localhost:6379/0

# --- Observability (not used yet) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- App ---
LATENCY_BUDGET_MS=3000
TRIGGER_CONFIDENCE_THRESHOLD=0.7
